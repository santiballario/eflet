# Copiar este archivo a ".env" y completar con tus datos reales.
# El archivo ".env" NUNCA se sube a Git (ver .gitignore).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eflet_db
DB_USER=root
DB_PASSWORD=

# --- Servidor ---
PORT=3000

# --- Autenticacion ---
# Generar uno propio, no usar un valor por defecto. Ejemplo para generarlo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- CORS ---
# Origen exacto del frontend (nunca "*" en un proyecto real)
CORS_ORIGIN=http://127.0.0.1:5500
